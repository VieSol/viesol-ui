{
  "name": "@viesol/liquid-glass",
  "version": "0.1.0",
  "description": "Reusable React primitives for the VieSol Liquid Glass design language.",
  "type": "module",
  "files": ["dist"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.css"
    }
  },
  "sideEffects": ["**/*.css"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VieSol/viesol-ui.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:demo": "vite build --config vite.demo.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "pnpm run typecheck && pnpm run test && pnpm run build",
    "prepare": "pnpm run build"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.0.1",
    "@vitejs/plugin-react": "^5.1.4",
    "jsdom": "^29.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "^6.0.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.34.5"
}
